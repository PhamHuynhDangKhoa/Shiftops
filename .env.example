# ==============================================================================
# ShiftOps Production Environment Variables Template
# Copy to .env and configure secret credentials before production deployment.
# Never commit real production credentials to version control.
# ==============================================================================

# Database Configuration (Mandatory in production)
POSTGRES_DB=shiftops
POSTGRES_USER=shiftops
POSTGRES_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD_HERE

# JWT Authentication (Mandatory in production: minimum 256-bit / 32-byte secret)
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_SECURE_JWT_SECRET_AT_LEAST_32_BYTES_HEX
JWT_EXPIRATION_MS=86400000

# File Storage (local or s3)
STORAGE_TYPE=local
UPLOAD_DIR=/app/uploads

# Cluster Object Storage (Required only when STORAGE_TYPE=s3)
# For MinIO: S3_ENDPOINT=http://minio:9000, S3_PATH_STYLE_ACCESS=true
# For AWS S3: leave S3_ENDPOINT empty, configure region & AWS credentials
S3_BUCKET=shiftops
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE_ACCESS=true
S3_AUTO_CREATE_BUCKET=true

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,https://shiftops.example.com

# Transactional Event Publication Registry (Spring Modulith)
EVENTS_REPUBLISH_DELAY_MS=30000
EVENTS_PURGE_CRON=0 0 3 * * *

# Reverse Proxy / Port Mapping
PORT=80
